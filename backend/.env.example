# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# The inbox that should receive contact-form messages
CONTACT_RECEIVER_EMAIL=yourmail@gmail.com

# SMTP credentials used to SEND the email (this is the sending account, not
# necessarily the same as the receiver above).
#
# If using Gmail as the sender:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#   3. Use that 16-character app password below (NOT your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password
